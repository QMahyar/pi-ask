{
  "name": "@qmahyar/pi-ask",
  "version": "1.0.0",
  "description": "Structured choice and text forms for agent-user decisions. ask_user extension for the pi coding agent.",
  "license": "MIT",
  "author": "QMahyar",
  "homepage": "https://github.com/QMahyar/pi-ask#readme",
  "bugs": {
    "url": "https://github.com/QMahyar/pi-ask/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QMahyar/pi-ask.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "ask-user",
    "questionnaire",
    "decision-form",
    "interactive",
    "tui",
    "forms"
  ],
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^25.9.5",
    "typebox": "^1.3.12",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "main": "src/api.ts",
  "exports": {
    "./api": "./src/api.ts",
    "./extension": "./src/extension.ts",
    "./package.json": "./package.json"
  }
}
